# ─── Keycloak ───
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN

# ─── PostgreSQL ───
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES

# ─── OpenLDAP ───
LDAP_ADMIN_PASSWORD=CHANGE_ME_LDAP_ADMIN

# ─── Application portail-rh (OIDC) ───
# Générer avec : openssl rand -hex 32  (lu par Terraform et par Flask)
OIDC_CLIENT_ID=portail-rh
OIDC_CLIENT_SECRET=CHANGE_ME_OIDC_CLIENT_SECRET

# Signe le cookie de session Flask. Générer avec : openssl rand -hex 32
FLASK_SECRET_KEY=CHANGE_ME_FLASK_SECRET

# ─── Terraform (dérivées des valeurs ci-dessus, ne pas modifier) ───
# Lues par Terraform après : set -a; . ../.env; set +a
TF_VAR_admin_user=${KC_BOOTSTRAP_ADMIN_USERNAME}
TF_VAR_admin_password=${KC_BOOTSTRAP_ADMIN_PASSWORD}
TF_VAR_ldap_bind_password=${LDAP_ADMIN_PASSWORD}
TF_VAR_portail_rh_client_secret=${OIDC_CLIENT_SECRET}
